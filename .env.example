# 复制为 .env（已被 gitignore）。Application 应将 MCP / workspace / models 指到应用自己的目录。
LLM_OPENAI_API_KEY=
LLM_DEFAULT_MODEL=
LLM_MODELS_CONFIG_PATH=configs/models.yaml
MCP_CONFIG_PATH=configs/mcp_servers.json
AGENT_WORKSPACE=workspace
SKILLS_DIR=skills
HOST=127.0.0.1
PORT=8000
AGENT_RECURSION_LIMIT=100
# 通用上下文压缩（extractive）
CONTEXT_COMPACT_ENABLED=true
CONTEXT_COMPACT_MAX_MESSAGES=20
CONTEXT_COMPACT_KEEP_RECENT=8
CONTEXT_COMPACT_MAX_CHARS=24000
CONTEXT_COMPACT_MAX_SUMMARY_CHARS=4000
